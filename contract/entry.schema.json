{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocfd5.org/schemas/aiml-entry-v1.json",
  "title": "AutoCFD5 AIML entry",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "split_id": {
            "enum": [
              "full",
              "medium",
              "scarce",
              "super_scarce",
              "geometry",
              "high_drag",
              "low_drag",
              "rear_separation"
            ]
          }
        },
        "required": [
          "split_id"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "train_case_ids"
              ]
            },
            {
              "required": [
                "validation_case_ids"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "train_case_ids",
          "validation_case_ids"
        ]
      }
    }
  ],
  "required": [
    "schema",
    "schema_version",
    "submission_id",
    "method_name",
    "contact_email",
    "split_id",
    "test_case_ids"
  ],
  "properties": {
    "schema": {
      "const": "autocfd5-aiml-entry-v1"
    },
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "method_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contact_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "split_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "prediction_scope": {
      "description": "Prediction supports supplied for every test case. Omission preserves the legacy surface_and_volume behavior.",
      "enum": [
        "surface_and_volume",
        "surface_only"
      ],
      "default": "surface_and_volume"
    },
    "train_case_ids": {
      "description": "Required only for a non-official split; complete ordered training membership.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "validation_case_ids": {
      "description": "Required only for a non-official split; complete ordered validation membership.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "test_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "prediction_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_immutable_url", "size_bytes", "sha256"],
      "properties": {
        "private_immutable_url": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
