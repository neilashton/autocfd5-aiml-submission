{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocfd5.org/schemas/aiml-entry-v1.json",
  "title": "AutoCFD5 AIML entry",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "split_id": {
            "enum": [
              "full",
              "medium",
              "scarce",
              "super_scarce",
              "geometry",
              "high_drag",
              "low_drag",
              "rear_separation"
            ]
          }
        },
        "required": [
          "split_id"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "train_case_ids"
              ]
            },
            {
              "required": [
                "validation_case_ids"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "train_case_ids",
          "validation_case_ids"
        ]
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "training_regime": {"const": "from_scratch"},
            "target_data_used": {"const": "official_train"},
            "external_pretraining": {"const": false},
            "pretraining_data": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "training_regime": {"const": "pretrained_zero_shot"},
            "target_data_used": {"const": "none"},
            "external_pretraining": {"const": true},
            "pretraining_data": {"minItems": 1}
          }
        },
        {
          "properties": {
            "training_regime": {"const": "pretrained_official_train"},
            "target_data_used": {"const": "official_train"},
            "external_pretraining": {"const": true},
            "pretraining_data": {"minItems": 1}
          }
        }
      ]
    }
  ],
  "required": [
    "schema",
    "schema_version",
    "submission_id",
    "method_name",
    "contact_email",
    "training_regime",
    "target_data_used",
    "external_pretraining",
    "pretraining_data",
    "split_id",
    "test_case_ids"
  ],
  "properties": {
    "schema": {
      "const": "autocfd5-aiml-entry-v1"
    },
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "method_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contact_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "training_regime": {
      "description": "How the submitted model used external pretraining and the official target training data.",
      "enum": [
        "from_scratch",
        "pretrained_zero_shot",
        "pretrained_official_train"
      ]
    },
    "target_data_used": {
      "description": "Whether model parameter updates used the official training split.",
      "enum": [
        "none",
        "official_train"
      ]
    },
    "external_pretraining": {
      "type": "boolean"
    },
    "pretraining_data": {
      "description": "Named external pretrained model, checkpoint, or dataset sources. Required for either pretrained regime.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "pattern": "^https?://",
                "maxLength": 2000
              }
            }
          }
        ]
      }
    },
    "split_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "prediction_scope": {
      "description": "Prediction supports supplied for every test case. Omission preserves the legacy surface_and_volume behavior.",
      "enum": [
        "surface_and_volume",
        "surface_only"
      ],
      "default": "surface_and_volume"
    },
    "force_prediction_source": {
      "description": "How the three scored force coefficients are supplied. Omission preserves field_integrated behaviour.",
      "enum": [
        "field_integrated",
        "direct_coefficients"
      ],
      "default": "field_integrated"
    },
    "train_case_ids": {
      "description": "Required only for a non-official split; complete ordered training membership.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "validation_case_ids": {
      "description": "Required only for a non-official split; complete ordered validation membership.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "test_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run_[1-9][0-9]*$"
      }
    },
    "prediction_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_immutable_url", "size_bytes", "sha256"],
      "properties": {
        "private_immutable_url": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
